{
  "name": "commandcode-goat-provider",
  "publisher": "HidenobuNagai",
  "displayName": "Command Code GOAT Provider",
  "description": "Command Code GOAT Chat Provider for VS Code Copilot Chat",
  "version": "0.1.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidenobunagai/commandcode-goat-provider"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "keywords": [
    "commandcode",
    "goat",
    "copilot",
    "chat",
    "provider",
    "claude",
    "deepseek",
    "qwen",
    "kimi"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "commandcode-goat",
        "displayName": "Command Code GOAT",
        "managementCommand": "commandcode-goat.manage"
      }
    ],
    "configuration": {
      "title": "Command Code GOAT",
      "properties": {
        "commandcode-goat.enableZdr": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable Command Code Zero Data Retention (ZDR) mode (`x-cmd-zdr: 1`) on requests."
        }
      }
    },
    "commands": [
      {
        "command": "commandcode-goat.manage",
        "title": "Manage API Key",
        "category": "Command Code GOAT"
      },
      {
        "command": "commandcode-goat.toggleDebugLogging",
        "title": "Toggle Debug Logging",
        "category": "Command Code GOAT"
      },
      {
        "command": "commandcode-goat.openDebugLog",
        "title": "Open Debug Log",
        "category": "Command Code GOAT"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "rm -rf out && tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check-changelog": "bun scripts/check-changelog.ts",
    "package:vsix": "bun run check-changelog && bun run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.20.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {}
}
